# Telegram bot token (get it from @BotFather)
BOT_TOKEN=9876543210:GetTokenFromGodFather-your0bot8token

# Telegram user_id of the bot owner (has access to /disable_invite, /enable_invite)
OWNER_USER_ID=123456789

# Comma-separated list of allowed Telegram user_ids
ALLOWED_USER_IDS=[123456789, 987654321]

# Secret token for invite link: t.me/your_bot?start=TOKEN
INVITE_TOKEN=your_secret_invite_token

# Public webhook URL (e.g. from Render)
WEBHOOK_URL=https://your-app.onrender.com

# Temporary directory for downloaded files
TEMP_DIR=temp

# Max file size in MB before uploading to Pixeldrain
MAX_FILE_SIZE_MB=50

# Timeout in seconds for Pixeldrain API requests
PIXELDRAIN_TIMEOUT_SEC=60

# Pixeldrain API key
PIXELDRAIN_API_KEY=your_pixeldrain_api_key