# Telegram bot token (get it from @BotFather)
BOT_TOKEN=9876543210:GetTokenFromGodFather-your0bot8token

# Your Telegram user_id (get it from @userinfobot)
ALLOWED_USER_ID=123456789

# Public webhook URL (e.g. from Render)
WEBHOOK_URL=https://your-app.onrender.com

# Temporary directory for downloaded files
TEMP_DIR=temp

# Max file size in MB before uploading to GoFile
MAX_FILE_SIZE_MB=50

# Max video duration in seconds (default: 3 hours)
MAX_VIDEO_DURATION_SEC=10800